# Copy this file to .env for local Docker Compose use. Never commit .env.
CLIENT_PORT=8080
CLIENT_URL=http://localhost:8080

# Compose starts a local MongoDB service with a persistent volume.
# For MongoDB Atlas, replace this URI with your URL-encoded Atlas connection string.
MONGODB_URI=mongodb://mongo:27017/voxigen

NODE_ENV=production
PORT=5000
NAVAMSHA_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
