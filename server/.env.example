# Voxigen Backend Environment Configuration
PORT=5000
CLIENT_URL=http://localhost:5173
# Transactional email for password reset links (Resend API)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Voxigen <no-reply@your-verified-domain.com>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/voxigen?retryWrites=true&w=majority
NAVAMSHA_API_KEY=your_navamsha_api_key_here
NODE_ENV=development
# Razorpay credentials (keep the secret on the server; never add it to client env)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Prices and validity are defined in server/src/config/products.ts.
# Razorpay credentials enable checkout; this catalog is one-time purchase (not auto-renewing).
